    "solver": "lbfgs",
    "max_iter": 2000,
    "random_state": 20260817,
    "preprocessing": "Existing 137-feature Train-only ColumnTransformer contract",
    "target": "official PLC place_hit",
    "population": "Existing LR1-derived Development population",
    "only_model_difference": "class_weight=None versus class_weight=balanced"
  },
  "calibration_contract": {
    "method": "sigmoid",
    "fit_source": "Each outer fold training period's expanding temporal OOF raw probabilities only",
    "oof_rule": "Use the first 3 calendar months for fitting, predict the next 3 months, then expand training by 3 months and repeat.",
    "preprocessing_scope": "Every OOF model fits preprocessing on its own historical training subset only",
    "class_weight_scope": "Each candidate uses its sealed class_weight in both OOF models and the outer full-training model",
    "evaluation_probability": "Apply the candidate-specific OOF sigmoid calibrator to that candidate's outer-fold raw probabilities",
    "selection_or_method_change_allowed": false
  },
  "temporal_folds": [
    {"fold_id": "fold_1", "train": "2023-01-01/2023-06-30", "evaluation": "2023-07-01/2023-09-30"},
    {"fold_id": "fold_2", "train": "2023-01-01/2023-09-30", "evaluation": "2023-10-01/2023-12-31"},
    {"fold_id": "fold_3", "train": "2023-01-01/2023-12-31", "evaluation": "2024-01-01/2024-03-31"},
